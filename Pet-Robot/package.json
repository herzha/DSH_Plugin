{
  "name": "dsh-pet-robot",
  "version": "1.6.1",
  "description": "dsh-pet-robot — a wasteland desktop pet for the DeepSeek Harness Web UI: draggable rust-bucket robot, optional task-completion chime, double-click balance readout, real window close and a welcome-screen lock.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/lock-screen.svg",
    "tools/gen-art.mjs",
    "tools/sync-profile.mjs",
    "tools/freeze.mjs",
    "tools/check.mjs",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "pet",
    "desktop-pet",
    "display",
    "robot",
    "wasteland"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  }
}
